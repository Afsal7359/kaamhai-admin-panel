# Backend API base URL
VITE_API_URL=https://devbackend.kaamhai.in
# For a local backend instead:
# VITE_API_URL=http://localhost:5001

# Optional — only needed against a production backend where the HMAC signature
# gate is enforced. Must match the backend's APP_NAME / PACKAGE_NAME / APP_SECRET.
# VITE_APP_NAME=
# VITE_PACKAGE_NAME=
# VITE_APP_SECRET=
# VITE_APP_VERSION=3.1.0
